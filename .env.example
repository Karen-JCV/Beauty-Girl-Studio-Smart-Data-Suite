ID_SALT = 

# --- Rutas de datos (estructura definida en 03_modelo_datos.md) ---
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
LOCAL_DATA_DIR=data/local
WAREHOUSE_DB_PATH=data/warehouse/beauty_studio.db
GOLD_DATA_DIR=data/gold

# Tabla puente con datos personales (SOLO local, nunca se versiona)
ID_BRIDGE_LOCAL_PATH=
DIM_CLIENTE_ANON_PATH=data/warehouse/dim_cliente_anon.parquet

# --- Contrato analítico / modelado (docs/architecture/contrato_analitico.md) ---
# Horizonte de retorno en días, usado para etiquetar retorna_en_90_dias
HORIZONTE_RETORNO_DIAS=90

# Margen de seguridad entre splits temporales (train/val/test), en días
MARGEN_SPLIT_TEMPORAL_DIAS=90

# Semilla aleatoria para reproducibilidad de modelos (train_test_split, RF, etc.)
RANDOM_SEED=42

# Umbrales provisionales de banda de riesgo sobre score_riesgo (0-100)
# Ver contrato_analitico.md §7 — deben ajustarse con datos reales antes de
# considerarse definitivos.
UMBRAL_RIESGO_MEDIO=40
UMBRAL_RIESGO_ALTO=70

# --- Dashboard (Streamlit) ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# --- Entorno ---
# development | production
APP_ENV=development
LOG_LEVEL=INFO